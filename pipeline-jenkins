pipeline{
    agent {label "slave"}
    stages{
        stage("Build"){
            steps{
                echo "cloning the ode from github"
                git branch: 'main',
                url: 'https://github.com/mahtabalam139/production-monitoring-dashboard.git'
            }
        }
        stage("Build the docker images"){
            steps{
                echo "building docker images"
                sh """
                docker build -t monitoring-dashboard:${BUILD_NUMBER} .
                docker tag monitoring-dashboard:${BUILD_NUMBER} monitoring-dashboard:latest
                """
            }
        }
        stage("stopping the docker process"){
            steps{
                echo "stop the docker process before running "
                sh """
                docker stop monitoring-dashboard || true
                docker rm monitoring-dashboard || true
                """
            }
        }
        stage("Deploy the container"){
            steps{
                echo "Deploying container from docker images "
                sh "docker run -d --name monitoring-dashboard -p 8000:8000 monitoring-dashboard:latest "
            }
        }
        stage("Veryfying the images an health check "){
            steps{
                echo "verifying the images "
                sleep time: 15, unit: 'SECONDS'
                sh 'curl http://localhost:8000'
                echo "Finnalllyyy Done "
            }
        }
        stage("push to docker hub"){
            steps{
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS')]){
                            sh '''
                            echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                            docker tag monitoring-dashboard:latest \
                            $DOCKER_USER/monitoring-dashboard:latest
                            docker push 
                            $DOCKER_USER/monitoring-dashboard:latest
                            '''
                        }
            }
        }  
    }
}
